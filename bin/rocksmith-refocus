#!/usr/bin/env python3
# Optional workaround for tiling window managers (dwm, i3, ...): Rocksmith can start
# "frozen" until it is refocused, because Wine misses the first focus the WM gives the
# window while it is still going fullscreen, so the game thinks it is in the background
# and pauses. Once the window has settled, bounce X focus to the root window; most
# tiling WMs immediately give it back, producing the same FocusOut/FocusIn a manual
# refocus does. X11 only.
import ctypes, ctypes.util, sys, time

x = ctypes.CDLL(ctypes.util.find_library("X11"))
x.XOpenDisplay.restype = ctypes.c_void_p
x.XDefaultRootWindow.restype = ctypes.c_ulong
x.XInternAtom.restype = ctypes.c_ulong
for f in ("XDefaultRootWindow", "XGetWindowProperty", "XSetInputFocus", "XSync", "XFree", "XInternAtom", "XGetInputFocus"):
    getattr(x, f).argtypes = None  # varied; pass ctypes-typed args explicitly

dpy = x.XOpenDisplay(None)
if not dpy:
    sys.exit("no display")
dpy = ctypes.c_void_p(dpy)
root = x.XDefaultRootWindow(dpy)

def prop(win, name, want_type):
    atom = x.XInternAtom(dpy, name.encode(), False)
    t, fmt = ctypes.c_ulong(), ctypes.c_int()
    n, after, data = ctypes.c_ulong(), ctypes.c_ulong(), ctypes.c_void_p()
    if x.XGetWindowProperty(dpy, ctypes.c_ulong(win), ctypes.c_ulong(atom), ctypes.c_long(0), ctypes.c_long(4096), False,
                            ctypes.c_ulong(want_type), ctypes.byref(t), ctypes.byref(fmt), ctypes.byref(n),
                            ctypes.byref(after), ctypes.byref(data)) != 0 or not data:
        return None
    try:
        if fmt.value == 8:
            return ctypes.string_at(data, n.value)
        return [ctypes.cast(data, ctypes.POINTER(ctypes.c_ulong))[i] for i in range(n.value)]
    finally:
        x.XFree(data)

def find_game():
    for w in prop(root, "_NET_CLIENT_LIST", 33) or []:   # 33 = XA_WINDOW
        cls = prop(w, "WM_CLASS", 31) or b""                # 31 = XA_STRING
        if cls.split(b"\0")[0] == b"steam_app_221680":
            return w
    return None

def fullscreen(w):
    fs = x.XInternAtom(dpy, b"_NET_WM_STATE_FULLSCREEN", False)
    return fs in (prop(w, "_NET_WM_STATE", 4) or [])        # 4 = XA_ATOM

deadline = time.time() + 180
while time.time() < deadline:
    w = find_game()
    if w and fullscreen(w):
        time.sleep(2)   # let Wine finish its fullscreen/map dance
        x.XSetInputFocus(dpy, ctypes.c_ulong(1), ctypes.c_int(1), ctypes.c_ulong(0))  # PointerRoot, RevertToPointerRoot, CurrentTime
        x.XSync(dpy, False)
        time.sleep(0.3)
        x.XSetInputFocus(dpy, ctypes.c_ulong(w), ctypes.c_int(1), ctypes.c_ulong(0))
        x.XSync(dpy, False)
        print("refocused", hex(w))
        sys.exit(0)
    time.sleep(0.5)
sys.exit("game window not found")
